{
  "name": "cycling-training-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MVP de app para ciclistas: anamnese, avaliacao de nivel e geracao de planos de treino de curto, medio e longo prazo com sessoes ilustradas passo a passo.",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build:unico": "SINGLE=1 vite build && node scripts/build-unico.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
